#!/usr/bin/env bash
# fuma launcher: 自动带上 --experimental-sqlite；NixOS 下优先使用 cloak-run（浏览器依赖 FHS）
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MAIN="$ROOT/dist/main.js"
if [ ! -f "$MAIN" ]; then
  echo "fuma: 未找到 $MAIN，请先运行 npm run build（或 ./scripts/install.sh）" >&2
  exit 2
fi
if [ -x "$HOME/cloak-env/bin/cloak-run" ]; then
  exec "$HOME/cloak-env/bin/cloak-run" node --experimental-sqlite "$MAIN" "$@"
fi
exec node --experimental-sqlite "$MAIN" "$@"
